# Copy to backend/.env and fill in. Never commit .env (it holds secrets).

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers).
MONGODB_URI=
# Database inside the cluster (default: rassm).
MONGODB_DB_NAME=rassm
# DNS servers for the Atlas lookup when this computer's DNS refuses it (some VPNs do,
# "querySrv ECONNREFUSED"). Comma-separated IPs; empty = no fallback.
DNS_FALLBACK_SERVERS=1.1.1.1,8.8.8.8

# Port of the API.
PORT=4000

# Website origin(s) allowed to call the API (CORS), comma-separated. The first one builds the
# links of the newsletter confirmation e-mails. An https site requires NODE_ENV=production.
# Production example: https://rassmstore.live,https://www.rassmstore.live
FRONTEND_ORIGIN=http://localhost:3000

# Optional: the dashboard's own origin when it runs on a subdomain (then only it may use the
# dashboard API). Production example: https://admin.rassmstore.live. Empty = the dashboard is
# on the site (FRONTEND_ORIGIN).
ADMIN_ORIGIN=

# Number of reverse proxies in front of the API (hosting load balancer), to read the
# real client IP (rate limiting, fraud checks). 0 when the API is reached directly.
# Required in production (see docs/SECURITY.md > Before going live).
TRUST_PROXY=0

# The website signs the visitor's IP of every dashboard request with this secret (same value
# as ADMIN_PROXY_SECRET in frontend/.env.local). 32+ random characters. Required in production.
ADMIN_PROXY_SECRET=

# Meta Conversions API (server-side Purchase events). Leave empty to send nothing.
# META_PIXEL_ID: same ID as NEXT_PUBLIC_META_PIXEL_ID in the frontend.
# META_CAPI_ACCESS_TOKEN: Events Manager > your Pixel > Settings > Conversions API > Generate access token.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional: Events Manager > Test events code, to check events without counting them.
# Remove it in production (the API warns loudly at startup when it is set there).
META_TEST_EVENT_CODE=
# Graph API version used for the Conversions API.
META_GRAPH_API_VERSION=v23.0

# New order, new message and alert e-mails, newsletter confirmation e-mails, password reset
# links and security alerts (Brevo transactional API). Leave BREVO_API_KEY empty to send none
# (on a local computer the reset and confirmation links are then written in the API logs).
# BREVO_API_KEY: Brevo > SMTP & API > API keys > Generate a new API key. Secret.
BREVO_API_KEY=
# Newsletter: the Brevo list where confirmed sign-ups go (Brevo > Contacts > Lists, the ID
# number). Empty = subscribers stay on the site only. Existing subscribers: pnpm sync-newsletter.
BREVO_NEWSLETTER_LIST_ID=
# Required with BREVO_API_KEY: who receives the team e-mails (new orders, messages, alerts),
# and the sender (an address or domain validated in Brevo > Senders, domains).
NOTIFY_EMAIL=
EMAIL_FROM=
# Product photos (Cloudinary > Settings > API Keys). Leave empty to disable uploads.
# CLOUDINARY_API_SECRET is secret: only the API uses it, never the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Cloudinary folder of the product photos.
CLOUDINARY_FOLDER=rassm/products

# Refreshes the website pages right after a dashboard change (products, delivery prices).
# Same long random value as REVALIDATE_SECRET in frontend/.env.local (24+ characters).
# REVALIDATE_URL defaults to the first FRONTEND_ORIGIN + /api/revalidate.
REVALIDATE_SECRET=
REVALIDATE_URL=

# Backups (pnpm backup): folder (relative to backend/), how many to keep, and the passphrase
# that encrypts them (AES-256-GCM, 16+ characters). Keep the passphrase in a password manager:
# without it an encrypted backup cannot be restored. Empty = not encrypted (local use only;
# refused in production unless `pnpm backup -- --unencrypted`).
BACKUP_DIR=backups
BACKUP_KEEP=14
BACKUP_PASSPHRASE=

# Dashboard URL, for the links in the e-mails (orders, messages, password reset links and
# security alerts). In production: https://admin.rassmstore.live/admin (dashboard subdomain)
# or https://<your domain>/admin.
ADMIN_URL=http://localhost:3000/admin
