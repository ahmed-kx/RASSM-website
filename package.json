{
  "name": "rassm",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @rassm/frontend --filter @rassm/backend dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "check-secrets": "node scripts/check-secrets.mjs --all",
    "seed": "pnpm --filter @rassm/backend seed",
    "create-admin": "pnpm --filter @rassm/backend create-admin",
    "migrate-images": "pnpm --filter @rassm/backend migrate-images",
    "sync-newsletter": "pnpm --filter @rassm/backend sync-newsletter",
    "backup": "pnpm --filter @rassm/backend backup",
    "restore": "pnpm --filter @rassm/backend restore",
    "purge-client-data": "pnpm --filter @rassm/backend purge-client-data"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3"
  }
}
