# Copy to .env.local and fill in. Only NEXT_PUBLIC_* variables reach the browser.

# Base URL of the Express API (used once the backend exists).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public URL of the site, used for SEO metadata (canonical and Open Graph URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meta Pixel ID (Meta Events Manager > Data sources). Leave empty to load no Meta script.
NEXT_PUBLIC_META_PIXEL_ID=
