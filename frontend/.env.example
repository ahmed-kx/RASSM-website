# Copy to .env.local and fill in. Only NEXT_PUBLIC_* variables reach the browser.

# Base URL of the Express API (backend/), called by the browser (order, contact, newsletter
# forms) and by the server (products, delivery fees).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional, server only: another URL for server-side calls (e.g. a private network address
# of the API in production). Defaults to NEXT_PUBLIC_API_URL.
API_URL=

# Public URL of the site, used for SEO metadata (canonical and Open Graph URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meta Pixel ID (Meta Events Manager > Data sources). Leave empty to load no Meta script.
NEXT_PUBLIC_META_PIXEL_ID=
